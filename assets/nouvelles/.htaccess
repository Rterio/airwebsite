# Les fichiers de ce dossier sont des images : ne jamais exécuter de code ici
<FilesMatch "\.(php|phtml|php\d|phar|pl|py|cgi|sh)$">
  Require all denied
</FilesMatch>
Options -Indexes -ExecCGI
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
